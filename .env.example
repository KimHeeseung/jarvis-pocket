HOST=0.0.0.0
PORT=8787
SERVER_URL=http://127.0.0.1:8787
APP_TOKEN=replace-with-a-random-token-at-least-32-characters
AGENT_TOKEN=replace-with-a-different-random-token-at-least-32-characters
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DATA_DIR=./data
AGENT_ROOT=./pc-files

# ChatGPT에 로그인된 Mac Codex로 실제 작업 (codex login)
AI_BACKEND=codex
CODEX_WORKSPACE=.
# Tailscale HTTPS 설정 후 자동 저장
JARVIS_MOBILE_URL=

# 추가 작업 폴더는 절대 경로 JSON 배열 (예: ["/Users/이름/Desktop"])
CODEX_EXTRA_DIRS=[]
# 새 프로젝트를 만들 기본 폴더. 비어 있으면 CODEX_WORKSPACE 사용
CODEX_PROJECTS_ROOT=
