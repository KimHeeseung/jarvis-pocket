{
  "name": "jarvis-pocket",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "server": "node --env-file=.env server/index.mjs",
    "agent": "node --env-file=.env agent/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "mobile:install": "npm --prefix mobile install",
    "mobile": "npm --prefix mobile start",
    "start": "node scripts/start.mjs",
    "remote:setup": "node scripts/remote-setup.mjs"
  }
}
